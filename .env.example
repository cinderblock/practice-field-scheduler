# Since the ".env" file is gitignored, you can use the ".env.example" file to
# build a new ".env" file when you clone the repo. Keep this file up-to-date
# when you add new variables to `.env`.

# This file will be committed to version control, so make sure not to have any
# secrets in it. If you are cloning this repo, create a copy of this file named
# ".env" and populate it with your secrets.

# When adding additional environment variables, the schema in "/src/env.js"
# should be updated accordingly.

# Next Auth
# You can generate a new secret on the command line with:
# npx auth secret
# https://next-auth.js.org/configuration/options#secret
AUTH_SECRET=""

# Next Auth Slack Provider
AUTH_SLACK_CLIENT_ID=""
AUTH_SLACK_CLIENT_SECRET=""
AUTH_SLACK_TEAM_ID="" # Optional, but recommended

# Next Auth URL for OAuth redirects
NEXTAUTH_URL=""

# For Team Icons and (eventually) Upcoming Events
FIRST_API_USERNAME=
FIRST_API_AUTH_TOKEN=

# Calendar Configuration
TIME_SLOT_BORDERS="-2, 4, 7, 10"  # Hours relative to noon (-12 to 12)
RESERVATION_DAYS="7"  # Number of days to show in calendar
TIME_ZONE="America/Los_Angeles"  # IANA timezone name

# Site Configuration
SITE_TITLE="Practice Field Scheduler"  # The title shown in the header

# Weather (optional). Leave WEATHER_LOCATION unset to hide weather entirely.
# Forecasts come from Open-Meteo (https://open-meteo.com), which needs no API key.
WEATHER_LOCATION=""  # "latitude,longitude" of the field (preferred), or a place name / postal code like "San Jose, CA"
WEATHER_API_KEY=""  # Optional. Only for Open-Meteo's commercial tier
WEATHER_UPDATES_PER_DAY="96"  # How often to refresh the forecast (96 = every 15 minutes)
WEATHER_FORECAST_DAYS="10"  # How many days ahead to fetch (1-16)

DATA_DIR="data"

# Shared bearer token for external integrations that need to ask whether
# a team's reservation grants them access to a tool (e.g. Gate Manager).
# Must be at least 32 characters. Leave unset to disable the access API
# (POST /api/access/check will return 503).
# Generate a strong value with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SCHEDULER_API_KEY=""

# Slack Bot User OAuth Token for sending messages (xoxb-...).
# Lives in the same Slack app as AUTH_SLACK_* above; add the bot scope
# `chat:write` (and `im:write` if DMs to opted-out users fail), then
# reinstall the app to the workspace and paste the Bot User token here.
# Leave unset to disable Slack messaging (DMs become no-ops).
SLACK_BOT_TOKEN=""

# Public base URL for Gate Manager (the tool that opens the practice-field
# gate). Used when DMing users their personal access link, which has the
# shape `${GATE_BASE_URL}/g/<accessToken>`. Leave unset to skip the link
# in DMs.
GATE_BASE_URL=""
