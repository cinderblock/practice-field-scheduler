NEXTAUTH_URL=https://not-used
AUTH_SECRET=AUTH_SECRET12345678
AUTH_SLACK_CLIENT_ID=1234567890
AUTH_SLACK_CLIENT_SECRET=AUTH_SLACK_CLIENT_SECRET12345678
AUTH_SLACK_SIGNING_SECRET=AUTH_SLACK_SIGNING_SECRET1234567

# FIRST API credentials. Dummy values; nothing in the unit tests calls out to the real API.
FIRST_API_USERNAME=test-user
FIRST_API_AUTH_TOKEN=00000000-0000-0000-0000-000000000000

# Calendar Configuration
TIME_SLOT_BORDERS="-2, 4, 7, 10"  # Hours relative to noon (-12 to 12)
RESERVATION_DAYS="7"  # Number of days to show in calendar
TIME_ZONE="America/Los_Angeles"  # IANA timezone name

# Site Configuration
SITE_TITLE="Practice Field Scheduler"  # The title shown in the header

TEST_AUTH_BYPASS=1

DATA_DIR=test/data

SCHEDULER_API_KEY=test-scheduler-key-do-not-use-in-prod

# Test-only stub. Real value is a Slack bot token (xoxb-...). The Slack
# client checks for the presence of this var and short-circuits to a
# logged warning if unset, so tests that mock fetch can rely on it being
# defined.
SLACK_BOT_TOKEN=xoxb-test-token-do-not-use-in-prod

GATE_BASE_URL=https://gate.example.test
